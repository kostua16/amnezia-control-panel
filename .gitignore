# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.venv
.venv/*
.venv/**/*
/**/.venv
/**/.venv/*
/**/.venv/**/*

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal
/src/generated/

# root-level SQLite DBs (local dev artifact); must never be committed
/dev.db
/dev.db-journal
/dev.db-shm
/dev.db-wal

# backups — contain full DB (creds, users); never commit
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude — keep project-mode Claude/GSD/RTK assets tracked
# so claude-code-action can safely restore them from the trusted base branch.
.claude/settings.local.json
.claude/hooks/.logs/

# Parallel .claude/ checkout created at runtime by claude-driven workflows
# (run-zai/claude-code-action) during CI agent runs. Never committed.
.claude-pr/

# npm
.npm-cache
.npm-cache/
**/.npm-cache
**/.npm-cache/
_cacache/
**/_cacache/



#logs
*/logs/*
*.log
**/*.log

# cursor
.cursor/hooks/state/continual-learning.json
.cursor/hooks/state/continual-learning-index.json

# app data
data/geoip/geoip.dat
data/geoip/geoip.dat.tmp


# GSD
.claude/gsd-install-state.json
.claude/gsd-migration-journal/


# Temporary files
agent-reports/

# Antigravity CLI settings
.antigravity/

# Python
__pycache__/
*.pyc

#OMO
.omo/run-continuation/*.json
.omo/boulder.json
.omo/plans/
.omo/notepads/
.omo/drafts/
.omo/cache/

# Graphify
graphify-out/


# worktrees
.worktrees/
.claude/worktrees/
.codex/worktrees/
