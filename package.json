    "@types/better-sqlite3": "^7.6.13",
    "@xyflow/react": "^12.11.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "prisma": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
