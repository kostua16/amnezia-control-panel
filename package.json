{
  "name": "amnezia-control-panel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "build:next": "next build",
    "build": "npm run prisma:generate && npm run build:next",
    "start": "node scripts/start.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck:only": "tsc --noEmit",
    "typecheck": "npm run prisma:generate && npm run typecheck:only",
    "test-only": "node --import tsx --test src/lib/__tests__/*.test.ts src/app/api/__tests__/*.test.ts",
    "test": "npm run prisma:generate && npm run typecheck:only && npm run test-only && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@tanstack/react-query": "^5.101.3",
    "@types/better-sqlite3": "^7.6.13",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "prisma": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.9.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^5.2.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6"
  },
  "overrides": {
    "ws": "^8.21.0",
    "@babel/core": "^7.29.7",
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.5.12",
    "sharp": "^0.35.0",
    "brace-expansion": "^5.0.8",
    "minimatch": {
      "brace-expansion": "^1.1.17"
    }
  }
}
