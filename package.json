  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "next build",
    "start": "node scripts/start.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
