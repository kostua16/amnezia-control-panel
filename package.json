    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^5.0.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6"
  },
  "overrides": {
    "ws": "^8.21.0",
    "@babel/core": "^7.29.7",
