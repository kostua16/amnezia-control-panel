generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────

enum ServiceType {
  AWG
  THREE_XUI
}

enum ServiceStatus {
  RUNNING
  STOPPED
  ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum QuotaPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum RoutingAction {
  ALLOW
  BLOCK
  ROUTE
}

enum GeoMatchType {
  COUNTRY
  REGION
  SPECIAL
}

enum GeoRuleSource {
  CUSTOM
  IMPORTED
  TEMPLATE
}

enum ChainTopology {
  LINEAR
  SPLIT
  MESH
}

enum RoutingTemplateCategory {
  GEO
  IP
  DOMAIN
  BUNDLE
}

// ─── Admin ────────────────────────────────────────────

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── User ────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  passwordHash    String
  displayName     String?
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false)
  trafficQuotaBytes Int     @default(0)
  speedLimitKbps  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trafficLogs     TrafficLog[]
  quotas          UserQuota[]
  protocols       UserProtocol[]
  routingRules    RoutingRule[]

  @@index([isActive])
  @@index([isBlocked])
  @@map("users")
}

// ─── Server ──────────────────────────────────────────

model Server {
  id          Int      @id @default(autoincrement())
  name        String
  hostname    String
  port        Int      @default(22)
  apiKeyHash  String
  tailnetIP        String?
  tailnetHostname  String?
  dnsName          String?
  advertisedSubnets String   @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services     Service[]
  trafficLogs  TrafficLog[]

  @@map("servers")
}

// ─── Service ─────────────────────────────────────────

model Service {
  id            Int           @id @default(autoincrement())
  type          ServiceType
  status        ServiceStatus @default(STOPPED)
  config        Json
  port          Int?
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  server        Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      Int
  configurations Configuration[]

  @@index([type])
  @@index([status])
  @@map("services")
}

// ─── ConfigTemplate ──────────────────────────────────

model ConfigTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  serviceType ServiceType?
  protocol    String
  content     Json
  description String   @default("")
  category    String   @default("protocol")
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("config_templates")
}

// ─── Configuration ───────────────────────────────────

model Configuration {
  id        Int      @id @default(autoincrement())
  type      String
  name      String
  content   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId Int?

  @@index([isActive])
  @@map("configurations")
}

// ─── TrafficLog ──────────────────────────────────────

model TrafficLog {
  id         Int      @id @default(autoincrement())
  bytesIn    Int      @default(0)
  bytesOut   Int      @default(0)
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId   Int

  @@index([userId])
  @@index([serverId])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@map("traffic_logs")
}

// ─── RoutingRule ─────────────────────────────────────

model RoutingRule {
  id          Int           @id @default(autoincrement())
  protocol    String
  destination String
  action      RoutingAction @default(ALLOW)
  priority    Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int?
  @@index([priority])
  @@map("routing_rules")
}

// ─── GeoRoutingRule ──────────────────────────────────────

model GeoRoutingRule {
  id          Int           @id @default(autoincrement())
  /** Human-readable rule name, e.g. "Block RU traffic" */
  name        String
  /** Match type: country, region, or special (domestic/foreign) per D-06, D-07 */
  matchType   GeoMatchType
  /** ISO 3166-1 alpha-2 country code, e.g. "US", "DE" (null if matchType != "country") */
  countryCode String?
  /** Region name, e.g. "Europe", "Asia-Pacific" (null if matchType != "region") */
  region      String?
  /** Special target: "domestic" or "foreign" (null if matchType != "special") */
  special     String?
  /** What to do with matching traffic */
  action      RoutingAction @default(ALLOW)
  /** Chain ID to route through (only if action = ROUTE) */
  chainId     Int?
  /** Rule priority (lower = higher precedence per D-07) */
  priority    Int           @default(0)
  /** Whether this rule is active */
  isActive    Boolean       @default(true)
  /** Source: "custom" for admin-created, "imported" for v2fly/rulite imports, "template" for template-applied (per D-09) */
  source      GeoRuleSource @default(CUSTOM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([priority])
  @@index([matchType])
  @@index([isActive])
  @@index([source])
  @@map("geo_routing_rules")
}

// ─── RoutingRuleTemplate ─────────────────────────────────

model RoutingRuleTemplate {
  id          Int      @id @default(autoincrement())
  /** Template display name */
  name        String
  /** Template description */
  description String   @default("")
  /** Category: "geo", "ip", "domain", "bundle" */
  category    RoutingTemplateCategory @default(GEO)
  /** Number of rules in this template */
  ruleCount   Int      @default(0)
  /** Whether this is a built-in template (not user-editable) */
  isBuiltIn   Boolean  @default(false)
  /** The rule definitions as JSON array */
  rules       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("routing_rule_templates")
}

// ─── ChainPreset ─────────────────────────────────────

model ChainPreset {
  id          Int      @id @default(autoincrement())
  /** Preset display name */
  name        String
  /** Preset description */
  description String   @default("")
  /** Topology type: linear, split, mesh */
  topology    ChainTopology @default(LINEAR)
  /** Number of nodes in the chain */
  nodeCount   Int      @default(2)
  /** Chain template ID reference (from BUILTIN_CHAIN_TEMPLATES) */
  chainTemplateId String
  /** Routing bundle ID reference (from BUILTIN_GEO_TEMPLATES or DB) */
  routingBundleId String?
  /** Protocol-specific overrides per node as JSON */
  protocolOverrides Json?
  /** Whether this is a built-in preset (not user-editable) */
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chain_presets")
}

// ─── Alert ───────────────────────────────────────────

model Alert {
  id        Int           @id @default(autoincrement())
  type      String
  severity  AlertSeverity @default(INFO)
  message   String
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([severity])
  @@index([createdAt])
  @@map("alerts")
}

// ─── UserQuota ───────────────────────────────────────

model UserQuota {
  id         Int          @id @default(autoincrement())
  quotaBytes Int          @default(0)
  period     QuotaPeriod  @default(MONTHLY)
  resetAt    DateTime?
  updatedAt  DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int          @unique
}

// ─── UserProtocol ────────────────────────────────────

model UserProtocol {
  id          Int         @id @default(autoincrement())
  serviceType ServiceType
  protocol    String
  config      Json
  isActive    Boolean     @default(true)
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  @@index([userId])
  @@index([isActive])
  @@map("user_protocols")
}

// ─── RemotePanel ─────────────────────────────────────

model RemotePanel {
  id          Int      @id @default(autoincrement())
  name        String
  panelUrl    String   @unique
  apiKeyHash  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connectionHistory PanelConnectionHistory[]

  @@map("remote_panels")
}

model PanelConnectionHistory {
  id        Int      @id @default(autoincrement())
  success   Boolean
  latencyMs Int?
  message   String
  version   String?
  checkedAt DateTime @default(now())

  panel     RemotePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  panelId   Int

  @@index([panelId])
  @@index([checkedAt])
  @@map("panel_connection_history")
}

// --- CachedPanelConfig ---

model CachedPanelConfig {
  id            Int      @id @default(autoincrement())
  /** Remote panel ID this config belongs to (null = this panel's own cached config) */
  panelId       Int?
  /** Monotonically increasing config version from central */
  configVersion Int
  /** The full config JSON payload */
  config        Json
  /** ISO timestamp when this config was received */
  receivedAt    DateTime @default(now())
  /** Previous config version (for rollback support) */
  previousConfigVersion Int?
  /** Previous config JSON (for rollback support) */
  previousConfig Json?
  /** When the previous config was received */
  previousConfigReceivedAt DateTime?

  @@unique([panelId])
  @@map("cached_panel_configs")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  resource   String
  resourceId String?
  actor      String   @default("admin")
  outcome    String   @default("success")
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
