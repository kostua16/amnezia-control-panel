#!/command/with-contenv bash
set -e

CONF="/opt/acp-stack/awg/awg0.conf"
IFACE="${AWG_INTERFACE:-awg0}"

if [ ! -f "$CONF" ]; then
  echo "[amneziawg] no config at $CONF yet; idle"
  exec sleep infinity
fi

if ! command -v amneziawg-go >/dev/null 2>&1; then
  echo "[amneziawg] amneziawg-go not found; bundled stack requires userspace AWG" >&2
  exit 1
fi

echo "[amneziawg] starting userspace tunnel on $IFACE"
exec amneziawg-go -f "$CONF" "$IFACE"
