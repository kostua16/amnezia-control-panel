#!/command/with-contenv bash
set -e

CONF="/opt/acp-stack/awg/awg0.conf"
IFACE="${AWG_INTERFACE:-awg0}"
pid=

cleanup() {
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  /docker/stack/scripts/awg-postdown.sh || true
}
trap cleanup EXIT TERM INT

if [ ! -f "$CONF" ]; then
  echo "[amneziawg] no config at $CONF yet; idle"
  exec sleep infinity
fi

if ! command -v amneziawg-go >/dev/null 2>&1; then
  echo "[amneziawg] amneziawg-go not found; bundled stack requires userspace AWG" >&2
  exit 1
fi

echo "[amneziawg] starting userspace tunnel on $IFACE"
amneziawg-go -f "$CONF" "$IFACE" &
pid=$!

/docker/stack/scripts/amneziawg-nat-up.sh

wait "$pid"
